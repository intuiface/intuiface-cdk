#!/usr/bin/env node
// Original source: https://github.com/prahladyeri/enforce-git-message/
// Minimal validation for Conventional Commits (disallow space before ':')

const examples = "Valid message pattern: <TYPE>[(<SCOPE>)]!?: <SUBJECT> \n" +
  "Valid types : 'feat', 'feature', 'fix', 'perf', 'refactor', 'style', 'test', 'build', 'docs', 'chore', 'ci', 'revert', 'deps' \n" +
  "Valid scopes: 'core', 'components', 'interface-asset', 'custom-asset', 'intuiface-cdk', 'cli', 'intuiface-cli', 'binding-converter', '*' \n" +
  "For more information, go to https://www.conventionalcommits.org/ \n" +
  "-                                 \n";

const fs = require('fs');

const regex = /^(feat|feature|fix|perf|refactor|style|test|build|docs|chore|ci|revert|deps)(\((core|components|interface-asset|custom-asset|intuiface-cdk|cli|intuiface-cli|binding-converter|\*)\))?!?:\s.+$/;
const regexMerge = /^(merge branch)\s.+$/i;

const commitMsg = fs.readFileSync(process.argv[2], 'utf8').trim();
const firstLine = commitMsg.split('\n')[0].trim().toLowerCase();

if (firstLine.match(regex) || firstLine.match(regexMerge)) {
  console.log('ok valid');
  process.exit(0);
} else {
  console.error('\n\nCOMMIT FAILED!');
  console.error('Please enter commit message in the conventional format and try to commit again.');
  console.error(examples);
  process.exit(1);
}
